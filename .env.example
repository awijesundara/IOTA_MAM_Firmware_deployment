# Copy to .env and fill in real values. All are optional; the app falls
# back to the original hardcoded placeholders/defaults when unset, matching
# the pre-modernization behaviour.

# IOTA node (legacy MAM / IOTA 1.0 style HTTP API) used to publish/fetch
# firmware announcements. The original public node used during the research
# project (tangle.anushkawijesundara.com) is not guaranteed to still be running.
IOTA_NODE_PROVIDER=https://tangle.anushkawijesundara.com:8443

# 81-character A-Z9 IOTA seed used to derive the MAM channel. Treat this as
# a secret; never commit a real seed.
IOTA_MAM_SEED=

# MAM channel root to subscribe to from the gateway/device self-test scripts.
IOTA_MAM_ROOT=

# IPFS (Kubo) HTTP RPC API used to pin uploaded firmware binaries.
IPFS_API_HOST=127.0.0.1
IPFS_API_PORT=5001
IPFS_API_PROTOCOL=http

# Local directory firmware binaries are written to, and the public base URL
# devices use to download them.
FIRMWARE_UPLOAD_DIR=/var/www/html/uploads/
FIRMWARE_PUBLIC_BASE_URL=http://vendor.local/uploads/

# Facebook OAuth app credentials (admin login), see config.js.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://www.figueiredos.com:3000/auth/facebook/callback
